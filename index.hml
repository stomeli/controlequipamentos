<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Controle de Equipamentos</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

<header class="topbar">

    <div class="logo-area">

        <div class="logo">
            ML
        </div>

        <div>
            <h1>Controle de Equipamentos</h1>
            <span>Gestão de retiradas e devoluções</span>
        </div>

    </div>

</header>


<!-- =========================
     MENU
========================= -->

<nav class="menu">

    <button
        class="menu-btn active"
        onclick="mostrarPagina('dashboard', this)"
    >
        Dashboard
    </button>


    <button
        class="menu-btn"
        onclick="mostrarPagina('colaboradores', this)"
    >
        Colaboradores
    </button>


    <button
        class="menu-btn"
        onclick="mostrarPagina('retirada', this)"
    >
        Registro de retirada
    </button>


    <button
        class="menu-btn"
        onclick="mostrarPagina('historico', this)"
    >
        Histórico
    </button>

</nav>


<main>


<!-- =========================
     DASHBOARD
========================= -->

<section id="dashboard" class="pagina active">

    <div class="pagina-header">

        <div>

            <h2>Dashboard</h2>

            <p>
                Visão geral dos equipamentos.
            </p>

        </div>

    </div>


    <div class="cards">

        <div class="card amarelo">

            <span>
                Total retirados
            </span>

            <strong id="totalRetirados">
                0
            </strong>

        </div>


        <div class="card verde">

            <span>
                Devolvidos
            </span>

            <strong id="totalDevolvidos">
                0
            </strong>

        </div>


        <div class="card vermelho">

            <span>
                Extraviados
            </span>

            <strong id="totalExtraviados">
                0
            </strong>

        </div>

    </div>


    <div class="painel">

        <h3>
            Buscar equipamento ou colaborador
        </h3>


        <div class="busca">

            <input
                type="text"
                id="buscaDashboard"
                placeholder="Digite LMS, nome ou código do equipamento"
            >


            <button onclick="buscarDashboard()">
                Buscar
            </button>

        </div>


        <div id="resultadoDashboard"></div>

    </div>

</section>



<!-- =========================
     COLABORADORES
========================= -->

<section id="colaboradores" class="pagina">

    <div class="pagina-header">

        <div>

            <h2>
                Colaboradores
            </h2>

            <p>
                Cadastre o LMS e o nome dos colaboradores.
            </p>

        </div>

    </div>


    <div class="painel">

        <h3>
            Novo colaborador
        </h3>


        <div class="form-grid">

            <div class="campo">

                <label for="cadastroLms">
                    LMS
                </label>

                <input
                    type="text"
                    id="cadastroLms"
                    placeholder="Ex.: LMS123456"
                >

            </div>


            <div class="campo">

                <label for="cadastroNome">
                    Nome do colaborador
                </label>

                <input
                    type="text"
                    id="cadastroNome"
                    placeholder="Nome completo"
                >

            </div>

        </div>


        <div class="acoes">

            <button
                class="btn-principal"
                onclick="cadastrarColaborador()"
            >
                Cadastrar colaborador
            </button>

        </div>

    </div>


    <div class="painel">

        <h3>
            Colaboradores cadastrados
        </h3>


        <div class="busca">

            <input
                type="text"
                id="buscaColaborador"
                placeholder="Buscar por LMS ou nome"
            >


            <button onclick="carregarColaboradores()">
                Buscar
            </button>


            <button
                class="btn-secundario"
                onclick="mostrarTodosColaboradores()"
            >
                Mostrar todos
            </button>

        </div>


        <div class="tabela-container">

            <table>

                <thead>

                    <tr>

                        <th>
                            LMS
                        </th>

                        <th>
                            Nome
                        </th>

                        <th>
                            Ações
                        </th>

                    </tr>

                </thead>


                <tbody id="tabelaColaboradores"></tbody>

            </table>

        </div>

    </div>

</section>



<!-- =========================
     REGISTRO DE RETIRADA
========================= -->

<section id="retirada" class="pagina">

    <div class="pagina-header">

        <div>

            <h2>
                Registro de retirada
            </h2>

            <p>
                Registre a retirada de um equipamento.
            </p>

        </div>

    </div>


    <div class="painel">

        <div class="form-grid">


            <!-- LMS -->

            <div class="campo">

                <label for="lms">
                    LMS do colaborador
                </label>

                <input
                    type="text"
                    id="lms"
                    placeholder="Digite o LMS"
                    oninput="buscarNomePorLms()"
                    autocomplete="off"
                >

                <small
                    id="statusLms"
                    class="status-lms"
                ></small>

            </div>


            <!-- NOME AUTOMÁTICO -->

            <div class="campo">

                <label for="nome">
                    Nome do colaborador
                </label>

                <input
                    type="text"
                    id="nome"
                    placeholder="O nome será preenchido automaticamente"
                    readonly
                >

            </div>


            <!-- EQUIPAMENTO -->

            <div class="campo">

                <label for="codigo">
                    Código do equipamento
                </label>

                <input
                    type="text"
                    id="codigo"
                    placeholder="Ex.: EQP001234"
                >

            </div>


            <!-- OBSERVAÇÃO -->

            <div class="campo">

                <label for="observacao">
                    Observação
                </label>

                <textarea
                    id="observacao"
                    rows="3"
                    placeholder="Digite uma observação, se necessário..."
                ></textarea>

            </div>

        </div>


        <div class="acoes">

            <button
                class="btn-principal"
                onclick="registrarRetirada()"
            >
                Registrar retirada
            </button>


            <button
                class="btn-secundario"
                onclick="buscarRetirada()"
            >
                Buscar
            </button>

        </div>


        <div id="resultadoRetirada"></div>

    </div>

</section>



<!-- =========================
     HISTÓRICO
========================= -->

<section id="historico" class="pagina">

    <div class="pagina-header">

        <div>

            <h2>
                Histórico
            </h2>

            <p>
                Consulte e gerencie os registros.
            </p>

        </div>

    </div>


    <div class="painel">


        <div class="busca">

            <input
                type="text"
                id="buscaHistorico"
                placeholder="Buscar por LMS, nome ou código"
            >


            <button onclick="carregarHistorico()">
                Buscar
            </button>


            <button
                class="btn-secundario"
                onclick="mostrarTodos()"
            >
                Mostrar todos
            </button>

        </div>


        <div class="tabela-container">

            <table>

                <thead>

                    <tr>

                        <th>LMS</th>

                        <th>Colaborador</th>

                        <th>Equipamento</th>

                        <th>Retirada</th>

                        <th>Devolução</th>

                        <th>Status</th>

                        <th>Observação</th>

                        <th>Ações</th>

                    </tr>

                </thead>


                <tbody id="tabelaHistorico"></tbody>

            </table>

        </div>

    </div>

</section>

</main>



<!-- =========================
     MODAL - EDITAR COLABORADOR
========================= -->

<div id="modalColaborador" class="modal">

    <div class="modal-content">

        <div class="modal-header">

            <h3>
                Editar colaborador
            </h3>


            <button onclick="fecharModalColaborador()">
                ×
            </button>

        </div>


        <input
            type="hidden"
            id="editarColaboradorId"
        >


        <div class="campo">

            <label>
                LMS
            </label>

            <input
                type="text"
                id="editarColaboradorLms"
            >

        </div>


        <div class="campo">

            <label>
                Nome do colaborador
            </label>

            <input
                type="text"
                id="editarColaboradorNome"
            >

        </div>


        <div class="modal-acoes">

            <button
                class="btn-principal"
                onclick="salvarEdicaoColaborador()"
            >
                Salvar alterações
            </button>


            <button
                class="btn-secundario"
                onclick="fecharModalColaborador()"
            >
                Cancelar
            </button>

        </div>

    </div>

</div>



<!-- =========================
     MODAL - EDITAR REGISTRO
========================= -->

<div id="modalEdicao" class="modal">

    <div class="modal-content">

        <div class="modal-header">

            <h3>
                Editar registro
            </h3>


            <button onclick="fecharModal()">
                ×
            </button>

        </div>


        <input
            type="hidden"
            id="editarId"
        >


        <div class="campo">

            <label>
                LMS
            </label>

            <input
                type="text"
                id="editarLms"
            >

        </div>


        <div class="campo">

            <label>
                Nome do colaborador
            </label>

            <input
                type="text"
                id="editarNome"
            >

        </div>


        <div class="campo">

            <label>
                Código do equipamento
            </label>

            <input
                type="text"
                id="editarCodigo"
            >

        </div>


        <div class="campo">

            <label>
                Status
            </label>

            <select id="editarStatus">

                <option value="retirado">
                    Retirado
                </option>

                <option value="devolvido">
                    Devolvido
                </option>

                <option value="extraviado">
                    Extraviado
                </option>

            </select>

        </div>


        <div class="campo">

            <label>
                Observação
            </label>

            <textarea
                id="editarObservacao"
                rows="4"
                placeholder="Observação..."
            ></textarea>

        </div>


        <div class="modal-acoes">

            <button
                class="btn-principal"
                onclick="salvarEdicao()"
            >
                Salvar alterações
            </button>


            <button
                class="btn-secundario"
                onclick="fecharModal()"
            >
                Cancelar
            </button>

        </div>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="script.js"></script>

</body>
</html>
